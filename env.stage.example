# Шаблон .env для стенда v2.tenirhotels.com (shared-хостинг, Plesk).
# Скопируйте в файл .env в корне сайта и подставьте свои значения.

APP_NAME="Tenir Hotels"
APP_ENV=production
# APP_KEY заполнит команда key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://v2.tenirhotels.com

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru

LOG_CHANNEL=single
LOG_LEVEL=warning

# База (создайте в Plesk → Базы данных)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# На shared-хостинге без очередей и Redis
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

MAIL_MAILER=log

# Кому открыта админка /admin (e-mail через запятую)
ADMIN_EMAILS=nurzhanadiluly@gmail.com

# Модуль бронирования Exely / TravelLine
EXELY_CONTEXT=TL-INT-tenirhotels
